{
  "schema": 1,
  "id": "ResourceMarkers",
  "name": "Resource Markers",
  "version": "1.0.0",
  "description": "Shows ores, rocks, plants and other gatherables on your map and the MiniMap mod.",
  "config": {
    "file": "settings.txt"
  },
  "settings": [
    {
      "type": "header",
      "label": "General"
    },
    {
      "key": "enabled",
      "type": "toggle",
      "label": "Show markers",
      "default": true,
      "restart": false
    },
    {
      "key": "hide_depleted",
      "type": "toggle",
      "label": "Hide mined / harvested",
      "default": true,
      "restart": false,
      "tooltip": "Skip rocks and plants that are currently empty."
    },
    {
      "key": "range_m",
      "type": "slider",
      "label": "Range",
      "min": 50,
      "max": 1000,
      "step": 50,
      "default": 250,
      "restart": false,
      "suffix": " m",
      "tooltip": "Marks things within this distance of you."
    },
